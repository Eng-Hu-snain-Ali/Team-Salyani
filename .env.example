# Environment Variables

# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Neon Database ─────────────────────────────────────
# Get from: https://console.neon.tech → Your Project → Connection String
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── JWT ──────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary ────────────────────────────────────────
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Rate Limiting ─────────────────────────────────────
# 15 minutes window, max 100 requests per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Booking ───────────────────────────────────────────
# Radius in km to search for nearby ustads
NEARBY_USTAD_RADIUS_KM=10
# Time in minutes before unaccepted booking expires
BOOKING_EXPIRY_MINUTES=10

# ─── Platform ──────────────────────────────────────────
# Commission percentage (10 = 10%)
PLATFORM_COMMISSION_PERCENT=10
